# Copie este arquivo para .env.local e preencha com as credenciais do seu projeto Supabase
# (Settings > API no painel do Supabase). Nunca commite o .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Usada só server-side. Desde a Fase 8, também usada pelo admin client
# (src/lib/supabase/admin.ts) do job diário — o cron não tem sessão de
# usuário, então precisa ignorar RLS pra ler/escrever de todos os clientes.
# NUNCA exponha ao client.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Groq (https://console.groq.com/keys) — usada pra gerar sugestões de post (Fase 2).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Nome do modelo Groq em uso. NUNCA hardcode isso no código — modelos Groq são
# depreciados com frequência. Veja os modelos disponíveis em
# https://console.groq.com/docs/models antes de rodar em produção.
GROQ_MODEL=llama-3.3-70b-versatile

# Fase 9 — protege src/app/api/cron/daily contra chamadas não autorizadas.
# Gere uma string aleatória de pelo menos 16 caracteres (ex.: um gerador de
# senha). Na Vercel, ao configurar essa env var e o cron job em vercel.json,
# a própria Vercel envia esse valor automaticamente no header
# `Authorization: Bearer <CRON_SECRET>` em toda invocação — não precisa
# configurar isso manualmente em nenhum outro lugar. Só necessária em
# produção pra rodar de verdade; localmente só importa se quiser testar a
# rota manualmente (ver PROGRESS.md, Fase 9).
CRON_SECRET=
